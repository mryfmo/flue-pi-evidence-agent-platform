}

test_inactive_dead_expired_wrong_environment_and_unknown_key_deny if {
	not allowed(valid_input, object.union(vector_trust, {"status": "inactive"}))
	dead_key := object.union(vector_trust.active_key, {"status": "inactive"})
	not allowed(valid_input, object.union(vector_trust, {"active_key": dead_key}))
	not allowed(valid_input, object.union(vector_trust, {"environment": "production"}))
	unknown_key := object.union(vector_trust.active_key, {"id": "rotated-key"})
	not allowed(valid_input, object.union(vector_trust, {"active_key": unknown_key}))
}

test_runtime_clock_boundaries_and_immediately_before_expiry if {
	run_start := time.parse_rfc3339_ns(vector_trust.expected.not_before)
	run_end := time.parse_rfc3339_ns(vector_trust.expected.not_after)
	not allowed_at(valid_input, vector_trust, run_start - 1)
	allowed_at(valid_input, vector_trust, run_end - 1)
	not allowed_at(valid_input, vector_trust, run_end)
	not allowed_at(valid_input, vector_trust, run_end + 1)
	key_end := time.parse_rfc3339_ns(vector_trust.active_key.expires_at)
	extended_expected := object.union(vector_trust.expected, {"not_after": "2028-07-13T00:00:00Z"})
	extended_trust := object.union(vector_trust, {"expected": extended_expected})
	allowed_at(valid_input, extended_trust, key_end - 1)
	not allowed_at(valid_input, extended_trust, key_end)
	not allowed_at(valid_input, extended_trust, key_end + 1)
}

test_trusted_artifact_catalog_path_digest_missing_extra_duplicate_deny if {
	path_substituted := array.concat([object.union(vector_trust.expected.artifacts[0], {"path": "/attacker/result.json"})], array.slice(vector_trust.expected.artifacts, 1, 6))
	path_expected := object.union(vector_trust.expected, {"artifacts": path_substituted})
	not allowed(valid_input, object.union(vector_trust, {"expected": path_expected}))
	digest_substituted := array.concat([object.union(vector_trust.expected.artifacts[0], {"digest": sprintf("sha256:%s", [concat("", ["0" | some i in numbers.range(1, 64)])])})], array.slice(vector_trust.expected.artifacts, 1, 6))
	digest_expected := object.union(vector_trust.expected, {"artifacts": digest_substituted})
	not allowed(valid_input, object.union(vector_trust, {"expected": digest_expected}))
	missing_expected := object.union(vector_trust.expected, {"artifacts": array.slice(vector_trust.expected.artifacts, 0, 5)})
	not allowed(valid_input, object.union(vector_trust, {"expected": missing_expected}))
	extra_expected := object.union(vector_trust.expected, {"artifacts": array.concat(vector_trust.expected.artifacts, [vector_trust.expected.artifacts[0]])})
	not allowed(valid_input, object.union(vector_trust, {"expected": extra_expected}))
	duplicated := array.concat([vector_trust.expected.artifacts[0]], array.slice(vector_trust.expected.artifacts, 0, 5))
	duplicate_expected := object.union(vector_trust.expected, {"artifacts": duplicated})
	not allowed(valid_input, object.union(vector_trust, {"expected": duplicate_expected}))
	duplicate_path_row := object.union(vector_trust.expected.artifacts[1], {"path": vector_trust.expected.artifacts[0].path})
	duplicate_paths := array.concat([vector_trust.expected.artifacts[0], duplicate_path_row], array.slice(vector_trust.expected.artifacts, 2, 6))
	not allowed(valid_input, object.union(vector_trust, {"expected": object.union(vector_trust.expected, {"artifacts": duplicate_paths})}))
	duplicate_digest_row := object.union(vector_trust.expected.artifacts[1], {"digest": vector_trust.expected.artifacts[0].digest})
	duplicate_digests := array.concat([vector_trust.expected.artifacts[0], duplicate_digest_row], array.slice(vector_trust.expected.artifacts, 2, 6))
	not allowed(valid_input, object.union(vector_trust, {"expected": object.union(vector_trust.expected, {"artifacts": duplicate_digests})}))
}

