test_revision1_internally_consistent_digest_bypass_denied if {
	artifact_digest := sprintf("sha256:%s", [concat("", ["d" | some i in numbers.range(1, 64)])])
	attestation_digest := sprintf("sha256:%s", [concat("", ["e" | some i in numbers.range(1, 64)])])
	rows := [object.union(row, {"evidence_digest": attestation_digest, "execution": object.union(row.execution, {"artifact": object.union(row.execution.artifact, {"uri": sprintf("cas://sha256/%s", [trim_prefix(artifact_digest, "sha256:")]), "digest": artifact_digest}), "attestation": object.union(row.execution.attestation, {"digest": attestation_digest, "subject_digest": artifact_digest})})}) | some row in valid_input.results]
	context := object.union(valid_input.verification_context, {"attestation_digests": [attestation_digest | some row in valid_input.results], "attestation_bundle_digest": sprintf("sha256:%s", [concat("", ["f" | some i in numbers.range(1, 64)])])})
	not allowed(object.union(valid_input, {"results": rows, "verification_context": context}), vector_trust)
}

test_untrusted_resigning_malformed_signature_key_and_algorithm_denied if {
	untrusted := "eyJhbGciOiJSUzI1NiIsImtpZCI6InNwZWMyMC10ZXN0LXZlY3Rvci1yczI1Ni12MSIsInR5cCI6IkpXVCJ9..lTdnlRs6WqzO7xv7VeB_nrujN02WwoOxWKEVr220nJxxo40Mi18sXhvqf_qjCoJXCmgAr0yjdjVZpYbtEhVFnMAjpSoRHXmDlhI3ckLnfpiW6iVLKTdWuWgLGj3xK88kIA3N0QykMbsZCgVs9bB7Yfio6IYPfzmsxXCATxzEGlyPCPk5BXbM7MMo4p7fGQVXe_2vn4mctiP9KEBHzmFjruTjbZbro9DD_ZYt0a0NKiELmbevZjxBgpOLlljo2h3Bmy_ABxs8rRZo4BfH_7gjerBapROfXr_mmlR3NvcrY40_ZE8rZC8VU8w6QCviSJjKFIe6momN5XhYJjdl_pwtMA"
	digest := sprintf("sha256:%s", [crypto.sha256(untrusted)])
	attestation := object.union(valid_input.results[0].execution.attestation, {"signed_jwt": untrusted, "digest": digest})
	row := object.union(valid_input.results[0], {"evidence_digest": digest, "execution": object.union(valid_input.results[0].execution, {"attestation": attestation})})
	not allowed(replace_result(0, row), vector_trust)
	malformed := sprintf("%sx", [valid_input.results[0].execution.attestation.signed_jwt])
	malformed_digest := sprintf("sha256:%s", [crypto.sha256(malformed)])
	malformed_attestation := object.union(valid_input.results[0].execution.attestation, {"signed_jwt": malformed, "digest": malformed_digest})
	not allowed(replace_result(0, object.union(valid_input.results[0], {"evidence_digest": malformed_digest, "execution": object.union(valid_input.results[0].execution, {"attestation": malformed_attestation})})), vector_trust)
	wrong_key := object.union(valid_input.results[0].execution.attestation, {"key_id": "attacker-key", "algorithm": "RS512"})
	not allowed(replace_result(0, object.union(valid_input.results[0], {"execution": object.union(valid_input.results[0].execution, {"attestation": wrong_key})})), vector_trust)
}

test_bundle_reordering_substitution_duplication_and_arbitrary_digest_denied if {
	reordered := array.reverse(valid_input.verification_context.attestation_digests)
	not allowed(object.union(valid_input, {"verification_context": object.union(valid_input.verification_context, {"attestation_digests": reordered})}), vector_trust)
	substituted := array.concat([sprintf("sha256:%s", [concat("", ["0" | some i in numbers.range(1, 64)])])], array.slice(valid_input.verification_context.attestation_digests, 1, 6))
	not allowed(object.union(valid_input, {"verification_context": object.union(valid_input.verification_context, {"attestation_digests": substituted})}), vector_trust)
	duplicated := array.concat([valid_input.verification_context.attestation_digests[0]], array.slice(valid_input.verification_context.attestation_digests, 0, 5))
	not allowed(object.union(valid_input, {"verification_context": object.union(valid_input.verification_context, {"attestation_digests": duplicated})}), vector_trust)
	not allowed(object.union(valid_input, {"verification_context": object.union(valid_input.verification_context, {"attestation_bundle_digest": sprintf("sha256:%s", [concat("", ["f" | some i in numbers.range(1, 64)])])})}), vector_trust)
}

test_default_production_absent_trust_and_test_key_production_deny if {
