anism","disposition":"superseded_non_normative"},{"requirement_id":"REQ-DATA-001","path":"docs/SPECIFICATION.md","locator":"SQLGlot, DuckDB, and Presidio as normative tool identities","disposition":"superseded_non_normative"}]}

replace_result(index, row) := object.union(valid_input, {"results": array.concat(array.slice(valid_input.results, 0, index), array.concat([row], array.slice(valid_input.results, index + 1, 6)))})

vector_now := time.parse_rfc3339_ns("2026-07-13T02:00:00Z")

allowed_at(candidate, candidate_trust, now) if {
	conformance.satisfied_test_vector with input as candidate with data.eap.conformance_trust as candidate_trust with time.now_ns as now
}

allowed(candidate, candidate_trust) if {
	allowed_at(candidate, candidate_trust, vector_now)
}

test_complete_capability_evidence_satisfies if {
	allowed(valid_input, vector_trust)
}

test_exact_set_missing_mixed_duplicate_extra_and_split_fail_closed if {
	not allowed(object.union(valid_input, {"results": array.slice(valid_input.results, 0, 5)}), vector_trust)
	tool_specific := object.union(valid_input.requirements[0], {"abstraction": "tool_specific"})
	not allowed(object.union(valid_input, {"requirements": [tool_specific, valid_input.requirements[1]]}), vector_trust)
	failed := object.union(valid_input.results[0], {"outcome": "failed"})
	not allowed(object.union(valid_input, {"results": array.concat(valid_input.results, [failed])}), vector_trust)
	extra := object.union(valid_input.results[0], {"test_id": "unlisted_test", "outcome": "failed"})
	not allowed(object.union(valid_input, {"results": array.concat(valid_input.results, [extra])}), vector_trust)
	wrong_source := object.union(valid_input.results[0], {"source_digest": sprintf("sha256:%s", [concat("", ["c" | some i in numbers.range(1, 64)])])})
	wrong_evidence := object.union(valid_input.results[1], {"evidence_digest": "manual"})
	not allowed(object.union(valid_input, {"results": array.concat([wrong_source, wrong_evidence], array.slice(valid_input.results, 2, 6))}), vector_trust)
}

