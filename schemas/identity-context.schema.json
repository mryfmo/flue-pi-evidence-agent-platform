{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flue-pi.local/schemas/identity-context.schema.json",
  "title": "OPA agent verified identity input",
  "type": "object",
  "required": ["identity_context", "request_context", "tool", "risk", "resource"],
  "additionalProperties": false,
  "properties": {
    "identity_context": {
      "description": "Immutable authentication result constructed by the gateway/PEP; never copied from the caller body.",
      "type": "object",
      "required": ["subject_id", "principal_type", "tenant_memberships", "roles", "issuer", "audience", "verification", "request_binding"],
      "additionalProperties": false,
      "properties": {
        "subject_id": { "type": "string", "minLength": 1 },
        "principal_type": { "const": "authenticated" },
        "tenant_memberships": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["platform_engineer", "software_engineer", "data_analyst", "security_reviewer"] } },
        "issuer": { "const": "flue-pi-identity-authority" },
        "audience": { "const": "flue-pi-agent-policy" },
        "verification": {
          "type": "object",
          "required": ["status", "owner"],
          "additionalProperties": false,
          "properties": {
            "status": { "const": "verified" },
            "owner": { "const": "flue-pi-platform-gateway" }
          }
        },
        "request_binding": {
          "type": "object",
          "required": ["id"],
          "additionalProperties": false,
          "properties": { "id": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "request_context": {
      "description": "Gateway/PEP-owned authorization context bound to the verified identity.",
      "type": "object",
      "required": ["tenant", "binding_id"],
      "additionalProperties": false,
      "properties": {
        "tenant": { "type": "string", "minLength": 1 },
        "binding_id": { "type": "string", "minLength": 1 }
      }
    },
    "tool": { "type": "string", "minLength": 1 },
    "risk": { "type": "string", "minLength": 1 },
    "resource": { "type": "string", "minLength": 1 }
  }
}
