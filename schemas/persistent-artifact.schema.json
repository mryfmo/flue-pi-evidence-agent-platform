{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flue-pi.local/schemas/persistent-artifact.schema.json",
  "title": "Tenant-bound persistent ledger, audit, and evidence artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "artifact_type", "tenant_id", "storage_path", "owner", "source", "pii_classification", "retention", "deletion", "legal_hold", "dsar", "access", "integrity"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "artifact_type": { "enum": ["ledger", "audit", "evidence"] },
    "tenant_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "storage_path": { "type": "string", "pattern": "^tenants/[A-Za-z0-9][A-Za-z0-9_-]*/(ledger|audit|evidence)/[^/].+$" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "subject_id"],
      "properties": {
        "tenant_id": { "type": "string", "minLength": 1 },
        "subject_id": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "task_id", "run_id", "revision", "digest"],
      "properties": {
        "tenant_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "pii_classification": { "enum": ["none", "pseudonymous", "personal", "sensitive"] },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_ref", "status"],
      "properties": {
        "policy_ref": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending_user_decision", "active", "expired"] }
      }
    },
    "deletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["active", "requested", "scheduled", "deleted", "blocked_by_legal_hold"] }
      }
    },
    "legal_hold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reference"],
      "properties": {
        "state": { "enum": ["none", "active", "released"] },
        "reference": { "type": ["string", "null"] }
      }
    },
    "dsar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlation_id", "status"],
      "properties": {
        "correlation_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["none", "received", "verified", "in_progress", "fulfilled", "rejected"] }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isolation_scope", "tenant_id", "authorized_roles", "metadata_source"],
      "properties": {
        "isolation_scope": { "const": "tenant" },
        "tenant_id": { "type": "string", "minLength": 1 },
        "authorized_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["platform_engineer", "software_engineer", "data_analyst", "security_reviewer"] }
        },
        "metadata_source": { "const": "flue-pi-platform-gateway" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "immutable", "version", "created_at"],
      "properties": {
        "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "immutable": { "type": "boolean" },
        "version": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "legal_hold": { "type": "object", "properties": { "state": { "const": "active" } }, "required": ["state"] } }, "required": ["legal_hold"] },
      "then": { "type": "object", "properties": { "legal_hold": { "type": "object", "properties": { "reference": { "type": "string", "minLength": 1 } } } } }
    },
    {
      "if": { "type": "object", "properties": { "legal_hold": { "type": "object", "properties": { "state": { "const": "none" } }, "required": ["state"] } }, "required": ["legal_hold"] },
      "then": { "type": "object", "properties": { "legal_hold": { "type": "object", "properties": { "reference": { "type": "null" } } } } }
    },
    {
      "if": { "type": "object", "properties": { "deletion": { "type": "object", "properties": { "state": { "const": "blocked_by_legal_hold" } }, "required": ["state"] } }, "required": ["deletion"] },
      "then": { "type": "object", "properties": { "legal_hold": { "type": "object", "properties": { "state": { "const": "active" } } } } }
    }
  ]
}
