# Anthropic production provider API key; required only when anthropic routes are enabled.
ANTHROPIC_API_KEY=

# LiteLLM Proxy admin key; set only in the proxy environment.
LITELLM_MASTER_KEY=

# LiteLLM virtual key exposed only to the platform gateway.
LITELLM_VIRTUAL_KEY=

# LiteLLM Proxy URL exposed to the platform gateway.
LITELLM_BASE_URL=http://127.0.0.1:4000

# OpenAI production provider API key; required only when openai routes are enabled.
OPENAI_API_KEY=

# Self-hosted OpenAI-compatible provider base URL; required only when vLLM routes are enabled.
VLLM_BASE_URL=

# Self-hosted OpenAI-compatible provider API key; required only when vLLM routes are enabled.
VLLM_API_KEY=

# Optional OPA binary override for local troubleshooting; normally unset.
EAP_OPA_BINARY=
